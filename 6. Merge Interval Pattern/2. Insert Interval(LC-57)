class Solution:
    def insert(self, intervals: List[List[int]], newInterval: List[int]) -> List[List[int]]:
        n=len(intervals)
        insert=False
        res=[]

        for i in range(n):
            current=intervals[i]

            if not insert and current[0]>=newInterval[0]:
                res.append(newInterval)
                insert=True
            res.append(current)
        # If newInterval belongs at the end
        if not insert:
            res.append(newInterval)

        ans=[res[0]]

        for i in range(1,len(res)):

            current=res[i]
            last=ans[-1]

            if current[0]<=last[1]:
                last[1]=max(current[1],last[1])
            else:
                ans.append(current)

        return ans


Complexity:

Time: O(n)-First loop takes O(n) and the merging loop also takes O(n), so O(n) + O(n) = O(n).
Space: O(n)-res can contain n + 1 intervals and ans can also contain up to n + 1 intervals.
