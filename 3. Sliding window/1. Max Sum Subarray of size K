class Solution:
    def maxSubarraySum(self, arr, k):
        
        n=len(arr)
        if n<k:
            return 0
            
        curr_sum=sum(arr[:k])
        max_sum=float("-inf")
        low,high=0,k-1
        
        while high<n:
            max_sum=max(max_sum,curr_sum)
            low+=1
            high+=1
            if high!=n:
                curr_sum= curr_sum+arr[high]-arr[low-1]
            else:
                break
        return max_sum
        
